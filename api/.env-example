NODE_ENV=development
APP_RUNTIME=local
PORT=3000
DATABASE_HOST=atrio_postgres
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=atrio
DB_LOG=false

REDIS_SCHEMA=redis
REDIS_HOST=atrio_redis
REDIS_PORT=6379

ACCESS_TOKEN_TTL_MINUTES=720
CHALLENGE_TTL_SECONDS=300
CHALLENGE_RESEND_COOLDOWN_SECONDS=60

STORAGE_DRIVER=local
LOCAL_STORAGE_DIRECTORY=storage
LOCAL_STORAGE_PUBLIC_BASE_URL=http://localhost:3000/storage

QUEUE_DRIVER=redis

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ENABLED=false

AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=atrio-dev

LOGSTASH_URL=127.0.0.1
LOGSTASH_PORT=5044

